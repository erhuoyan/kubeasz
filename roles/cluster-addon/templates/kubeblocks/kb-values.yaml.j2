nodeSelector:
  node-role.kubernetes.io/infra: ""
tolerations:
  - key: node-role.kubernetes.io/infra
    operator: Exists
    effect: NoSchedule
  # 保留 chart 默认的 kb-controller 容忍：写了 tolerations 会整体替换默认值
  - key: kb-controller
    operator: Equal
    value: "true"
    effect: NoSchedule

## KubeBlocks container image settings
image:
  registry: easzlab.io.local:5000

## Resource settings
resources:
  cpu: 500m
  memory: 1Gi

# dynamically replace instance's registry. ref: https://github.com/apecloud/kubeblocks/pull/8018
registryConfig:
  defaultRegistry: easzlab.io.local:5000
  defaultNamespace: apecloud

## Data protection settings
dataProtection:
  enabled: true
  tolerations:
    - key: node-role.kubernetes.io/infra
      operator: Exists
      effect: NoSchedule
    - key: kb-controller
      operator: Equal
      value: "true"
      effect: NoSchedule

## @param autoInstalledAddons - the list of auto-installed addons when install and upgrade.
autoInstalledAddons:
  - "mongodb"
  - "mysql"
  - "postgresql"
  - "redis"

controllers:
  apps:
    enabled: true
  workloads:
    enabled: true
  operations:
    enabled: true
  experimental:
    enabled: false
  trace:
    enabled: false

featureGates:
  ignoreConfigTemplateDefaultMode:
    enabled: false
  ignorePodVerticalScaling:
    enabled: false
  componentReplicasAnnotation:
    enabled: true
  inPlacePodVerticalScaling:
    enabled: false
